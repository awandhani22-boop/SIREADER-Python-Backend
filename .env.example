# ============================================================
# SIREADER PYTHON BACKEND — ENVIRONMENT TEMPLATE (.env.example)
# ============================================================
# SALIN FILE INI MENJADI .env DAN ISI DENGAN NILAI NYATA.
# DILARANG MENG-COMMIT FILE .env ASLI KE VERSION CONTROL!
# ============================================================

# DATABASE CONFIGURATION
# Core Telegram Daemon Write Connection (Supabase Session Pooler port 5432)
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@your_supabase_host:5432/postgres

# Dedicated Read-Only API Gateway Connection (Role: sireader_api_ro, SELECT only)
SIREADER_API_DATABASE_URL=postgresql+psycopg://sireader_api_ro:your_ro_password_here@your_supabase_host:5432/postgres

# API GATEWAY AUTHENTICATION (Server-to-Server Pre-Shared Bearer Token)
# Minimal 32 karakter acak. Dilarang ditaruh di frontend bundle!
SIREADER_API_AUTH_TOKEN=your_secure_random_api_auth_token_here_min_32_chars
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dedicated worker-runtime writer identity (never reuse DATABASE_URL/postgres).
# Required before any LIVE worker mode; provision only after separate staging/security approval.
WORKER_DATABASE_URL=

# Isolated local Workforce Command API (never point to Supabase LIVE)
SIREADER_WORKFORCE_COMMAND_DATABASE_URL=
SIREADER_WORKFORCE_COMMAND_AUTH_TOKEN=
WORKFORCE_COMMAND_HOST=127.0.0.1
WORKFORCE_COMMAND_PORT=8010
SIREADER_WORKFORCE_MAINTENANCE_DATABASE_URL=

# SYSTEM & TRADING SAFETY CONTROLS
EXECUTION_MODE=APPROVAL
TRADING_MODE=DRY_RUN
REQUIRE_MANUAL_APPROVAL=True
AUTO_EXECUTION_ENABLED=False
TIMEZONE=Asia/Jakarta

# TELEGRAM CLIENT (Telethon Listener)
TELEGRAM_API_ID=00000000
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_TARGET_CHAT_ID=-1000000000000

# TELEGRAM APPROVAL BOT (python-telegram-bot)
TELEGRAM_BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_APPROVER_USER_ID=000000000

# MT5 MARKET DATA (Read-Only)
MT5_TERMINAL_PATH=
MT5_EXPECTED_SERVER=
MT5_SYMBOL=
MT5_MAX_TICK_AGE_SECONDS=15
TRADE_DECISION_WATCH_ENABLED=False

# LOCAL OMNIROUTE — Anthropic Messages-compatible gateway
# Paste the OmniRoute server API key into AI_API_KEY in the private .env only.
# This is the OmniRoute key (e.g. the existing SIREADER_CLAUDE key), not the upstream provider key.
AI_PROVIDER=omniroute
AI_API_KEY=
ANTHROPIC_API_KEY=
AI_BASE_URL=http://127.0.0.1:20128
ANTHROPIC_API_VERSION=2023-06-01
AI_TIMEOUT_SECONDS=120
AI_ALLOW_INSECURE_TEST_ENDPOINT=False
AI_PROMPT_CACHING_ENABLED=True
AI_PROMPT_CACHE_TTL=5m

# Exact model IDs currently allowlisted on the OmniRoute SIREADER_CLAUDE key.
AI_MODEL_FAST=anthropic/claude-haiku-5-5
AI_MAX_OUTPUT_FAST=700
AI_MODEL_REASONING=anthropic/claude-sonnet-5-5
AI_MAX_OUTPUT_REASONING=1400
AI_MODEL_ESCALATION=anthropic/claude-opus-5-5
AI_MAX_OUTPUT_ESCALATION=1800

# Anthropic USD accounting; legacy IDR pricing is retained for historical rows.
AI_ANTHROPIC_MODEL_PREFIX=anthropic/
# USD daily hard cap; 0 keeps all paid Anthropic calls blocked until explicitly approved.
AI_ANTHROPIC_DAILY_BUDGET_USD=0.00
AI_ANTHROPIC_MONTHLY_BUDGET_USD=5.00
AI_ANTHROPIC_WARNING_THRESHOLDS=0.70,0.85,0.95
AI_ANTHROPIC_LONG_CONTEXT_TOKENS=100000
AI_MAX_RETRIES=0
AI_ENABLE_DEDUPLICATION=True

# Legacy IDR pricing remains for historical TokenMurah ledger rows only.
AI_TARGET_DAILY_BUDGET_RP=10000
AI_HARD_DAILY_LIMIT_RP=50000
AI_MONTHLY_BUDGET_RP=50000
AI_BUDGET_PERIOD_DAYS=30

# Worker runtime remains disabled until a separate operational approval.
WORKER_RUNTIME_ENABLED=False
WORKER_PROVIDER_MODE=MOCK
WORKER_LIVE_PROVIDER_ENABLED=False
WORKER_MAX_TASK_COST_USD=0
